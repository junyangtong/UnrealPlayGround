// Continuous layer transitions. Height is not offset at the blend boundary.
float4 colors[5]={Color0,Color1,Color2,Color3,Color4};
float4 detail[5]={Detail0,Detail1,Detail2,Detail3,Detail4};
float2 uv=UV+float2(Swirl,0);
float masks[5]={Texture2DSample(Mask0,Mask0Sampler,uv*10).r,Texture2DSample(Mask1,Mask1Sampler,uv*10).r,Texture2DSample(Mask2,Mask2Sampler,uv*10).r,Texture2DSample(Mask3,Mask3Sampler,uv*10).r,Texture2DSample(Mask4,Mask4Sampler,uv*10).r};
float4 weights[5]={Weight0,Weight1,Weight2,Weight3,Weight4};
float tails[5]={Tail0,Tail1,Tail2,Tail3,Tail4};
float mixed[5];
for(int j=0;j<5;j++) mixed[j]=dot(weights[j],float4(masks[0],masks[1],masks[2],masks[3]))+tails[j]*masks[4];
float h=HeightUV.x*5;
int last=clamp((int)LayerCount-1,0,4);
int lo=clamp((int)floor(h-.5),0,last),hi=min(lo+1,last);
float noise=Texture2DSample(NoiseTex,NoiseTexSampler,uv*max(.1,detail[hi].w)).r;
float t=smoothstep(hi-max(.01,detail[hi].x),hi+max(.01,detail[hi].x),h);
t=saturate(t+(noise-.5)*detail[hi].z*(1-abs(t-.5)*2));
float4 col=lerp(colors[lo],colors[hi],t);
float mask=lerp(mixed[lo],mixed[hi],t);
float bubbles=lerp(detail[lo].y,detail[hi].y,t);
float3 n=normalize(Normal),v=normalize(View);
float facing=saturate(abs(dot(n,v))),edge=pow(1-facing,3);
// FBX islands cover a small atlas area: increase repeat to retain fine bubble detail.
float2 buv=uv*float2(2,4)+float2(0,-Clock*.025);
float b0=Texture2DSample(BubbleTex,BubbleTexSampler,buv+View.xy*.05).r;
float b1=Texture2DSample(BubbleTex,BubbleTexSampler,buv*1.37+View.xy*.09+float2(.13,Clock*.008)).r;
float top=saturate(HeightUV.y);
float waterline=1-smoothstep(0,.009,abs(HeightUV.x-Fill));
float3 env=TextureCubeSampleLevel(Environment,EnvironmentSampler,reflect(-v,n),2).rgb;
float3 rgb=col.rgb*(.78+.22*facing)+col.rgb*(b0+b1)*min(bubbles,3)*.65*pow(facing,3)*(1-top)+mask*col.rgb*.08;
rgb+=env*(.018+edge*.08);
float3 surface=colors[last].rgb*.85+env*.16;
rgb=lerp(rgb,surface,top);
rgb+=waterline*col.rgb*.10;
return float4(rgb,saturate(col.a+edge*.08+waterline*.08));
